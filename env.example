# =============================================================================
# Venti AI Platform — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Anthropic
# Required to run the demo script and for Claude Code agents.
# Each engineer provides their own key; do NOT share keys across teammates.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# Phoenix
# PHOENIX_SECRET: random string used for signing. Generate with:
#   openssl rand -hex 32
# PHOENIX_DB_PASSWORD: password for the Phoenix PostgreSQL database.
# PHOENIX_ENABLE_AUTH: set to "true" for production deployments.
#   When false, the Phoenix UI is open with no login (fine for local dev).
# PHOENIX_PROJECT_NAME: logical grouping for traces in the Phoenix UI.
# -----------------------------------------------------------------------------
PHOENIX_SECRET=change-me-generate-with-openssl-rand-hex-32
PHOENIX_DB_PASSWORD=phoenix
PHOENIX_ENABLE_AUTH=false
PHOENIX_PROJECT_NAME=venti-claude-code

# Phoenix OTLP endpoint (where your instrumented code sends traces).
# Use this in your application or demo script.
# gRPC:  http://localhost:4317
# HTTP:  http://localhost:4318
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
